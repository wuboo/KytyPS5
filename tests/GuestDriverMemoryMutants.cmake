# Mutation tests of guestDriverMemory.h, generated like GpuKeepWarmMutants.cmake: a copy of the production header with one expression
# changed lands in the build directory, and each mutant's test must fail (WILL_FAIL). A stale `from` text fails the configuration.

set(KYTY_GDM_MUTANT_DIR "${CMAKE_CURRENT_BINARY_DIR}/guest_driver_memory_mutants")
set(KYTY_GDM_HEADER_REL "kernel/guestDriverMemory.h")

set(KYTY_GDM_MUTANTS always_preferred no_align end_off_by_one bottom_of_region)
set(KYTY_GDM_FROM_always_preferred "if (preferred <= reserved_max && size - 1u <= reserved_max - preferred) {")
set(KYTY_GDM_TO_always_preferred "if (true) {")
set(KYTY_GDM_FROM_no_align "return (reserved_max + 1u - size) & ~(size - 1u);")
set(KYTY_GDM_TO_no_align "return reserved_max + 1u - size;")
set(KYTY_GDM_FROM_end_off_by_one "size - 1u <= reserved_max - preferred")
set(KYTY_GDM_TO_end_off_by_one "size <= reserved_max - preferred")
set(KYTY_GDM_FROM_bottom_of_region "return (reserved_max + 1u - size) & ~(size - 1u);")
set(KYTY_GDM_TO_bottom_of_region "return 0x40000;")

set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KYTY_SOURCE_DIR}/${KYTY_GDM_HEADER_REL}")
file(READ "${KYTY_SOURCE_DIR}/${KYTY_GDM_HEADER_REL}" KYTY_GDM_TEXT)
foreach(mutant IN LISTS KYTY_GDM_MUTANTS)
	set(from "${KYTY_GDM_FROM_${mutant}}")
	string(FIND "${KYTY_GDM_TEXT}" "${from}" first)
	if(first EQUAL -1)
		message(FATAL_ERROR "guest_driver_memory mutant ${mutant}: text not found in ${KYTY_GDM_HEADER_REL}: ${from}")
	endif()
	string(REPLACE "${from}" "@@GDM_MUTANT_SITE@@" probe "${KYTY_GDM_TEXT}")
	string(REGEX MATCHALL "@@GDM_MUTANT_SITE@@" hits "${probe}")
	list(LENGTH hits count)
	if(NOT count EQUAL 1)
		message(FATAL_ERROR "guest_driver_memory mutant ${mutant}: text occurs ${count} times in ${KYTY_GDM_HEADER_REL}: ${from}")
	endif()
	string(REPLACE "${from}" "${KYTY_GDM_TO_${mutant}}" mutated "${KYTY_GDM_TEXT}")
	file(WRITE "${KYTY_GDM_MUTANT_DIR}/${mutant}/${KYTY_GDM_HEADER_REL}" "${mutated}")
	add_executable(guest_driver_memory_mutant_${mutant}_tests EXCLUDE_FROM_ALL "${KYTY_TESTS_DIR}/GuestDriverMemoryTests.cpp")
	target_include_directories(guest_driver_memory_mutant_${mutant}_tests BEFORE PRIVATE "${KYTY_GDM_MUTANT_DIR}/${mutant}" ${inc_headers})
endforeach()
